{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "_comment_secrets": "ConnectionStrings, Jwt:SigningKey, OpenAI:ApiKey, Smtp:Username/Password, and Authentication:Google/Facebook client secrets are intentionally NOT set here. Provide them via environment variables, dotnet user-secrets (development), or appsettings.Production.json (production, gitignored, pushed by hand outside CI/CD per FR-035) — never commit them to source control (constitution §8, docs/SECURITY.md §22).",

  "App": {
    "FrontendBaseUrl": "https://asklucy.io"
  },

  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },

  "Smtp": {
    "Host": "mail.bimcatalyst.com",
    "Port": 587,
    "FromName": "Ask Lucy",
    "FromTransactional": "noreply@bimcatalyst.com",
    "FromSupport": "support@bimcatalyst.com",
    "FromPrivacy": "privacy@bimcatalyst.com"
  },

  "Jwt": {
    "Issuer": "https://asklucy.io",
    "Audience": "https://asklucy.io",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },

  "OpenAI": {
    "ChatModel": "gpt-3.5-turbo",
    "ImageModel": "dall-e-3",
    "TranscriptionModel": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1/"
  },

  "FileStorage": {
    "RootPath": "App_Data/avatars"
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
