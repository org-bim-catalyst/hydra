# Google Maps Platform JavaScript API key, restricted to this app's domains (HTTP referrer
# restriction) in the Google Cloud Console. Used client-side by the viewer's GIS/map layer
# (specs/027-immersive-viewer-platform) — this is a public, domain-restricted key, not a secret
# (research.md Decision "API key custody").
VITE_GOOGLE_MAPS_API_KEY=

# A vector-rendering-enabled Map ID (Google Cloud Console -> Google Maps Platform -> Map
# Management -> Create Map ID -> Map type "JavaScript", Map style "Vector", with "Tilt" and
# "Rotation" toggled on for that Map ID). Without this, the map still loads but stays a flat
# 2D raster map — no WebGLOverlayView 3D bridging, no tilt/rotation camera control.
VITE_GOOGLE_MAPS_MAP_ID=

# specs/048-buildings-only-map-style (research.md Decision 4): a second vector Map ID with a
# cloud-based style attached (docs/google-maps-styles/buildings-only-{light,dark}.cloud.json —
# one Map ID's Light/Dark style variants cover both themes) that hides everything except building
# footprints. Selecting "Buildings only" recreates the map with this Map ID instead of
# VITE_GOOGLE_MAPS_MAP_ID above. Only relevant when VITE_GOOGLE_MAPS_MAP_ID is also set — on a
# raster deployment (no Map ID at all), "Buildings only" already works via a client-side style and
# this var is unused. Leaving it unset on a vector deployment simply omits "Buildings only" from
# the map style menu (isBuildingsOnlyStyleSupported) rather than offering a choice that would
# silently do nothing.
VITE_GOOGLE_MAPS_BUILDINGS_ONLY_MAP_ID=
