# Google Maps Platform JavaScript API key, restricted to this app's domains (HTTP referrer
# restriction) in the Google Cloud Console. Used client-side by the viewer's GIS/map layer
# (specs/027-immersive-viewer-platform) — this is a public, domain-restricted key, not a secret
# (research.md Decision "API key custody").
VITE_GOOGLE_MAPS_API_KEY=

# A vector-rendering-enabled Map ID (Google Cloud Console -> Google Maps Platform -> Map
# Management -> Create Map ID -> Map type "JavaScript", Map style "Vector", with "Tilt" and
# "Rotation" toggled on for that Map ID). Without this, the map still loads but stays a flat
# 2D raster map — no WebGLOverlayView 3D bridging, no tilt/rotation camera control.
VITE_GOOGLE_MAPS_MAP_ID=
