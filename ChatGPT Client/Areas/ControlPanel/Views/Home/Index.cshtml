@model AskLucy.Areas.Identity.Models.ApplicationUser;

<link href="~/css/controlpanel.css" rel="stylesheet" />
@{
    Layout = "~/views/shared/_LayoutControlPanel.cshtml";
}
<!-- https://csshint.com/bootstrap-grid-examples/ -->

<header>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <!-- Container wrapper -->
        <div class="container-fluid">
            <!-- Toggle button -->
            <button class="navbar-toggler"
                    type="button"
                    data-mdb-toggle="collapse"
                    data-mdb-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Collapsible wrapper -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <!-- Navbar brand -->
                <a class="navbar-brand mt-2 mt-lg-0" href="#">
                    <img src="/img/Lucy.png"
                         alt="MDB Logo"
                         loading="lazy"
                         class="rounded-circle shadow-1-strong"
                         width="50"
                         height="50" />
                </a>
                <!-- Left links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="btn btn-success d-inline-block ripple-surface" href="/home/index"><i class="fa fa-chevron-left" aria-hidden="true"></i> Back to Lucy</a>
                    </li>
                </ul>
                <!-- Left links -->
            </div>
            <!-- Right elements -->
            <div class="d-flex align-items-center">
                <!-- Icon -->
                @*<a class="link-secondary me-3" href="#">
                <i class="fas fa-shopping-cart"></i>
                </a>*@
                @*<h5 class="mb-3">@Model.FirstName</h5>*@

                <!-- Avatar -->
                <div class="dropdown">
                    <a class="dropdown-toggle d-flex align-items-center hidden-arrow"
                       href="#"
                       id="navbarDropdownMenuAvatar"
                       role="button"
                       data-mdb-toggle="dropdown"
                       aria-expanded="false">
                        <img src="data:image/jpg;base64,@(Html.Raw(Convert.ToBase64String(Model.ProfilePicture!)))"
                             class="rounded-circle shadow-1-strong"
                             height="50"
                             width="50"
                             alt="Black and White Portrait of a Man"
                             loading="lazy" />
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-lg-end dropr multiselect-container dcustom-scrollbar" aria-labelledby="navbarDropdownMenuAvatar" >
                        <li class="multiselect-selected">
                            <a class="dropdown-item" id="profile" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-user"></i> <span>My Profile</span>
                            </a>
                        </li>
                        <li class="multiselect-selected">
                            <a class="dropdown-item" id="settings" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-cog"></i> <span>Settings</span>
                            </a>
                        </li>
                        @*                        <li class="multiselect-selected">
                        <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="skinToggler" />
                        <label class="form-check-label" for="skinToggler">Enable Dark Mode.</label>
                        </div>
                        </li>*@
                        <li class="multiselect-selected">
                            <a class="dropdown-item" href="#" data-mdb-toggle="modal" data-mdb-target="#modal-log-out">
                                <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- Right elements -->
        </div>
        <!-- Container wrapper -->
    </nav>
    <!-- Navbar -->
</header>

<main class="mdb-docs-layout custom-scrollbar">
    <section>
        <div class="container two-col-example">
            <div class="row mt-3">
                <div class="card-deck mb-1 col-lg-4 col-sm-6 text-center">
                    <div class="card mb-4 box-shadow">
                        <a href="/controlpanel/home/usersmanager" class="hover-overlay ripple" data-mdb-ripple-color="light">
                            <div class="card-body">
                                <i class="fas fa-user-circle fa-4x com-icon text-primary"></i>
                                <h4 class="card-title">Users Manager</h4>
                                <p class="mt-3 mb-4 card-text">Remove, change, or unlock your user.</p>
                            </div>
                        </a>
                    </div>
                    <div class="card mb-4 box-shadow">
                        <a href="" class="hover-overlay ripple" data-mdb-ripple-color="light">
                        <div class="card-body">
                                <i class="fas fa-cloud fa-4x com-icon text-primary"></i>
                            <h4 class="card-title">Cloud Conferencing Support</h4>
                            <p class="mt-3 mb-4 card-text">Setup or schedule a Webex or other video conference.</p>
                        </div>
                        </a>
                    </div>
                </div>
                <div class="card-deck mb-1 col-lg-4 col-sm-6 text-center">
                    <div class="card mb-4 box-shadow">
                        <a href="" class="hover-overlay ripple" data-mdb-ripple-color="light">
                        <div class="card-body">
                                <i class="fas fa-laptop fa-4x com-icon text-primary"></i>
                            <h4 class="card-title">Order New Hardware</h4>
                            <p class="mt-3 mb-4 card-text">
                                Order a new laptop, phone, or other hardware.
                            </p>
                        </div>
                        </a>
                    </div>
                    <div class="card mb-4 box-shadow">
                        <a href="" class="hover-overlay ripple" data-mdb-ripple-color="light">

                        <div class="card-body">
                                <i class="fas fa-calendar-alt fa-4x com-icon text-primary"></i>
                            <h4 class="card-title">Meeting Help</h4>
                            <p class="mt-3 mb-4 card-text">Learn how to schedule a meeting or reserve a conference room.</p>
                        </div>
                        </a>

                    </div>
                </div>
                <div class="card-deck mb-1 col-lg-4 col-sm-6 text-center">
                    <div class="card mb-4 box-shadow">
                        <a href="" class="hover-overlay ripple" data-mdb-ripple-color="light">

                        <div class="card-body">
                                <i class="fas fa-print fa-4x com-icon text-primary"></i>
                            <h4 class="card-title">Printer Help</h4>
                            <p class="mt-3 mb-4 card-text">
                                Get help accessing a network printer or request service.
                            </p>
                        </div>
                        </a>

                    </div>
                    <div class="card mb-4 box-shadow">
                        <a href="" class="hover-overlay ripple" data-mdb-ripple-color="light">

                        <div class="card-body">
                                <i class="fas fa-podcast fa-4x com-icon text-primary"></i>
                            <h4 class="card-title">Request VPN Access</h4>
                            <p class="mt-3 mb-4 card-text">Setup Comcast VPN on your company issued device.</p>
                        </div>
                        </a>

                    </div>
                </div>
                <div class="main-button">
                    <button type="button" class="btn btn-primary com-button">See More Topics</button>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="card-deck mb-3 text-center">
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-shield-alt fa-4x com-icon"></i>
                        <h4 class="card-title">Password Help</h4>
                        <p class="mt-3 mb-4">Reset, change, or unlock your NT/Login password.</p>
                    </div>
                </div>
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-cloud fa-4x com-icon"></i>
                        <h4 class="card-title">Cloud Conferencing Support</h4>
                        <p class="mt-3 mb-4">Setup or schedule a Webex or other video conference.</p>
                    </div>
                </div>
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-laptop fa-4x com-icon"></i>
                        <h4 class="card-title">Order New Hardware</h4>
                        <p class="mt-3 mb-4">
                            Order a new laptop, phone, or other hardware.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="card-deck mb-3 text-center">
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-shield-alt fa-4x com-icon"></i>
                        <h4 class="card-title">Password Help</h4>
                        <p class="mt-3 mb-4">Reset, change, or unlock your NT/Login password.</p>
                    </div>
                </div>
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-cloud fa-4x com-icon"></i>
                        <h4 class="card-title">Cloud Conferencing Support</h4>
                        <p class="mt-3 mb-4">Setup or schedule a Webex or other video conference.</p>
                    </div>
                </div>
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-laptop fa-4x com-icon"></i>
                        <h4 class="card-title">Order New Hardware</h4>
                        <p class="mt-3 mb-4">
                            Order a new laptop, phone, or other hardware.
                        </p>
                    </div>
                </div>
                <div class="card mb-4 box-shadow">
                    <div class="card-body">
                        <i class="fas fa-calendar-alt fa-4x com-icon"></i>
                        <h4 class="card-title">Meeting Help</h4>
                        <p class="mt-3 mb-4">Learn how to schedule a meeting or reserve a conference room.</p>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <div class="modal fade" id="modal-log-out" tabindex="-1" aria-labelledby="modal-label-log-out" aria-hidden="true" data-mdb-backdrop="static" data-mdb-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-label-log-out">Logout confirmation</h5>
                    <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="form-label" for="customFile">Are you sure you eant to logout?</p>
                </div>
                <div class="modal-footer">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-sm btn-primary" id="button-log-out">confirm</button>
                        <button type="button" class="btn btn-sm btn-danger" data-mdb-dismiss="modal">Close</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</main>