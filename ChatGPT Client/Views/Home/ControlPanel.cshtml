
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="~/css/datatables.css" />

@using AskLucy.Areas.Identity.Models;
@model ApplicationUser;
@{
    ViewData["Title"] = "Control Panel";
}

<header>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <!-- Container wrapper -->
        <div class="container-fluid">
            <!-- Toggle button -->
            <button class="navbar-toggler"
                    type="button"
                    data-mdb-toggle="collapse"
                    data-mdb-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Collapsible wrapper -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <!-- Navbar brand -->
                <a class="navbar-brand mt-2 mt-lg-0" href="#">
                    <img src="/img/Lucy.png"
                         alt="MDB Logo"
                         loading="lazy"
                         class="rounded-circle shadow-1-strong"
                         width="50"
                         height="50" />
                </a>
                <!-- Left links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link btn btn-sm" href="/home/index"><i class="fa fa-chevron-left" aria-hidden="true"></i> Back to Lucy</a>
                    </li>
                </ul>
                <!-- Left links -->
            </div>
            <!-- Right elements -->
            <div class="d-flex align-items-center">
                <!-- Icon -->
                @*<a class="link-secondary me-3" href="#">
                <i class="fas fa-shopping-cart"></i>
                </a>*@
                @*<h5 class="mb-3">@Model.FirstName</h5>*@

                <!-- Avatar -->
                <div class="dropdown">
                    <a class="dropdown-toggle d-flex align-items-center hidden-arrow"
                       href="#"
                       id="navbarDropdownMenuAvatar"
                       role="button"
                       data-mdb-toggle="dropdown"
                       aria-expanded="false">
                        <img src="data:image/jpg;base64,@(Html.Raw(Convert.ToBase64String(Model.ProfilePicture!)))"
                             class="rounded-circle shadow-1-strong"
                             height="50"
                             width="50"
                             alt="Black and White Portrait of a Man"
                             loading="lazy" />
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-lg-end dropr multiselect-container dcustom-scrollbar" aria-labelledby="navbarDropdownMenuAvatar">
                        <li class="multiselect-selected">
                            <a class="dropdown-item" id="profile" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-user"></i> <span>My Profile</span>
                            </a>
                        </li>
                        <li class="multiselect-selected">
                            <a class="dropdown-item" id="settings" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-cog"></i> <span>Settings</span>
                            </a>
                        </li>
                        @*                        <li class="multiselect-selected">
                        <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="skinToggler" />
                        <label class="form-check-label" for="skinToggler">Enable Dark Mode.</label>
                        </div>
                        </li>*@
                        <li class="multiselect-selected">
                            <a class="dropdown-item" href="#" data-mdb-toggle="modal" data-mdb-target="#modal-log-out">
                                <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- Right elements -->
        </div>
        <!-- Container wrapper -->
    </nav>
    <!-- Navbar -->
</header>
<main class="pt-5 mdb-docs-layout custom-scrollbar">
    <section>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <table id="myTable" class="table table-responsive w-100">
                        <thead>
                            <tr>
                                <th class="all">ProfilePicture</th>
                                <th class="all">First Name</th>
                                <th class="all">Last Name</th>
                                <th class="all">Birth Date</th>
                                <th class="all">Id</th>
                                <th class="all">User Name</th>
                                <th class="all">Normalized User Name</th>
                                <th class="all">Email</th>
                                <th class="all">Normalized Email</th>
                                <th class="all">Email Confirmed</th>
                                <th class="all">Password Hash</th>
                                <th class="all">Security Stamp</th>
                                <th class="all">Concurrency Stamp</th>
                                <th class="all">Phone Number</th>
                                <th class="all">Phone Number Confirmed</th>
                                <th class="all">Two Factor Enabled</th>
                                <th class="all">Lockout End</th>
                                <th class="all">Lockout Enabled</th>
                                <th class="all">Access Failed Count</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <div class="modal fade" id="modal-log-out" tabindex="-1" aria-labelledby="modal-label-log-out" aria-hidden="true" data-mdb-backdrop="static" data-mdb-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-label-log-out">Logout confirmation</h5>
                    <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="form-label" for="customFile">Are you sure you eant to logout?</p>
                </div>
                <div class="modal-footer">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-sm btn-primary" id="button-log-out">confirm</button>
                        <button type="button" class="btn btn-sm btn-danger" data-mdb-dismiss="modal">Close</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section scripts{
    <script src="~/js/app_users_manager.js" asp-append-version="true"></script>
    <script>

        $(() => {

            var app = new app_ask_lucy();

        });

    </script>
}