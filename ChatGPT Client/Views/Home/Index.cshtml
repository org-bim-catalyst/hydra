@model AskLucy.Areas.Identity.Models.ApplicationUser;
@{
    ViewData["Title"] = "Home";
}
<header>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <!-- Container wrapper -->
        <div class="container-fluid">
            <!-- Toggle button -->
            <button class="navbar-toggler"
                    type="button"
                    data-mdb-toggle="collapse"
                    data-mdb-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Collapsible wrapper -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <!-- Navbar brand -->
                <a class="navbar-brand mt-2 mt-lg-0" href="#">
                    <img src="/img/Lucy.png"
                         alt="MDB Logo"
                         loading="lazy"
                         class="rounded-circle shadow-1-strong"
                         width="50"
                         height="50" />
                </a>
                <!-- Left links -->
                <ul class="navbar-nav me-auto mb-lg-0">
                    <li class="nav-item align-self-center">
                        <span class="navbar-text me-2" for="select-languages">Language: </span>

                    </li>
                    <li class="nav-item">
                        <select class="select custom-scrollbar" id="select-languages">
                        </select>
                    </li>
                    @*<li class="nav-item">
                    <a class="nav-link" href="#">Team</a>
                    </li>
                    <li class="nav-item">
                    <a class="nav-link" href="#">Projects</a>
                    </li>*@
                </ul>
                <!-- Left links -->
            </div>
            <!-- Collapsible wrapper -->
            <div class="collapse navbar-collapse justify-content-center"
                 id="navbarCenteredExample">
                <!-- Left links -->
                <ul class="navbar-nav w-100">
                    <li class="nav-item">
                        <div class="w-100 rounded-pill bg-light border border-success border-1 mt-1" id="visualizer-container">
                            @*<svg class="svg-visualizer" width="75" height="75"></svg>*@
                            <canvas class="canvas-visualizer pt-2" width="275" height="15"></canvas>
                        </div>
                    </li>
                    <li class="nav-item">

                        <button type="button" class="btn btn-warning btn-floating link-secondary ms-3" id="mute">
                            <i class="fas fa-microphone-alt-slash"></i>
                        </button>
                    </li>                    <!-- Navbar dropdown -->
                </ul>
                <!-- Left links -->
            </div>

            <!-- Right elements -->
            <div class="d-flex align-items-center">
                <!-- Icon -->
                @*            <a class="link-secondary me-3" href="#">
                <i class="fas fa-shopping-cart"></i>
                </a>*@
                @*<h5 class="mb-3">@Model.FirstName</h5>*@

                <!-- Avatar -->
                <div class="dropdown">
                    <a class="dropdown-toggle d-flex align-items-center hidden-arrow"
                       href="#"
                       id="navbarDropdownMenuAvatar"
                       role="button"
                       data-mdb-toggle="dropdown"
                       aria-expanded="false">
                        <img src="data:image/jpg;base64,@(Html.Raw(Convert.ToBase64String(Model.ProfilePicture!)))"
                             class="rounded-circle shadow-1-strong"
                             height="50"
                             width="50"
                             alt="Black and White Portrait of a Man"
                             loading="lazy" />
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-lg-end dropr multiselect-container dcustom-scrollbar" aria-labelledby="navbarDropdownMenuAvatar">
                        <li class ="multiselect-selected">
                            <a class="dropdown-item" id="profile" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-user"></i> My Profile
                            </a>
                        </li>
                        <li class="multiselect-selected">
                            <a class="dropdown-item" id="settings" href="/Identity/Account/Manage/Index">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="multiselect-selected">
                            <a class="dropdown-item" href="#" data-mdb-toggle="modal" data-mdb-target="#modal-log-out">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- Right elements -->
        </div>
        <!-- Container wrapper -->
    </nav>
    <!-- Navbar -->
</header>
<main class="pt-1 mdb-docs-layout">
    <section>
        <div class="container-fluid">
            <div class="col-12">
                <div class="card" style="height: auto;">
                    @*<div class="card-header">
                    <!-- Checked switch -->
                    <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" />
                    <label class="form-check-label" for="flexSwitchCheckChecked">Audio chat is not enabled.</label>
                    </div>


                    </div>*@
                    <div class="card-body" id="div-chat-dialogue">
                        <ul class="list-unstyled custom-scrollbar" id="ul-chat-dialogue">
                        </ul>
                    </div>
                    <div class="card-footer">
                        <ul class="list-inline">
                            <li class="mb-1">
                                <div class="row">
                                    <div class="col-9">
                                        <div class="form-outline bg-white">
                                            <textarea class="form-control active custom-scrollbar" id="textArea-chat-message" rows="4" data-emojiable="true"></textarea>
                                            <label class="form-label" for="textArea-chat-message">Message</label>
                                        </div>

                                    </div>

                                    <div class="col-3 border border-info border-1 rounded">
                                        <h6 class="mt-2 text-muted">Attachments</h6>

                                        <ol class="list-group list-group-light bg-white" id="ul-chat-attachments">
                                        </ol>
                                    </div>
                                </div>
                            </li>
                        </ul>
                        <button type="button" class="btn btn-secondary btn-rounded" data-mdb-toggle="modal" data-mdb-target="#modal-upload-file"><i class="fas fa-paperclip"></i> <span>upload</span></button>
                        @*<button type="button" class="btn btn-danger btn-rounded" id="button-translate-message"><i class="fas fa-language"></i> <span>Translate</span></button>*@
                        <button type="button" class="btn btn-primary btn-rounded float-end" id="button-send-message"><i class="fas fa-paper-plane"></i> <span>Send</span></button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal Upload File-->
        <div class="modal fade" id="modal-upload-file" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel"><i class="fas fa-paperclip"></i> Attach file to conversation:</h5>
                        <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @*<label class="form-label" for="customFile">Please select file to upload</label>*@
                        <input type="file" class="form-control btn-outline-primary" id="customFile" />
                        <div class="progress mt-3">
                            <div class="progress-bar"
                                 id="progress-pdf-parser"
                                 role="progressbar"
                                 style="width: 0%;"
                                 aria-valuenow="0"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                        <p class="note note-warning mt-3">
                            <strong>File info:</strong> <span id="span-file-info">No file is loaded.</span>
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-mdb-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Logout-->
        <div class="modal fade" id="modal-log-out" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Logout confirmation</h5>
                        <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="form-label" for="customFile">Are you sure you eant to logout?</p>
                    </div>
                    <div class="modal-footer">
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                            <button type="submit" class="btn btn-sm btn-primary" id="button-log-out">confirm</button>
                            <button type="button" class="btn btn-sm btn-danger" data-mdb-dismiss="modal">Close</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </section>
</main>
@section scripts{
    <script src="~/js/app_open_ai.js" asp-append-version="true"></script>
    <script>

        //https://stackoverflow.com/questions/57098561/the-character-is-converted-into-x2b-in-base64-encoded-data
        let profilePicture = 'data:image/jpg;base64,@(Html.Raw(Convert.ToBase64String(Model.ProfilePicture!)))';
        let userFirstName = '@Model.FirstName';

        $(() => {

            var app = new app_open_ai(userFirstName, profilePicture);

        });

    </script>
}
