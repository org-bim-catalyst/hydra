@{
    ViewData["Title"] = "Home";
}

<section>
    <div class="container-fluid m-0">
        <section style="height: 100vh;">
            <div class="bg-image h-100 w-100">
                <div class="d-md-flex mt-3 align-items-center h-100">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-6 col-lg-7 col-xl-9">
                                <div class="card" style="height: auto;">
                                    <div class="card-header">
                                        <!-- Checked switch -->
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" />
                                            <label class="form-check-label" for="flexSwitchCheckChecked">Audio chat is not enabled.</label>

                                        <div class="float-end">
                                            @*<label class="text-muted" for="inlineFormSelectPref">Language: </label>*@
                                                <select class="select custom-scrollbar" id="select-languages">

                                            </select>
                                        </div>
                                        </div>
                                    </div>
                                    <div class="card-body" id="div-chat-dialogue">
                                        <ul class="list-unstyled custom-scrollbar" id="ul-chat-dialogue">

                                        </ul>
                                    </div>
                                    <div class="card-footer">
                                        <ul class="list-unstyled">
                                        <li class="bg-white mb-3">
                                            <div class="form-outline">
                                                <textarea class="form-control" id="textArea-message" rows="4"></textarea>
                                                <label class="form-label" for="textAreaExample2">Message</label>
                                            </div>
                                        </li>
                                        </ul>
                                        <button type="button" class="btn btn-primary btn-rounded" data-mdb-toggle="modal" data-mdb-target="#modal-upload-file"><i class="fas fa-file-upload"></i> <span>upload</span></button>
                                        <button type="button" class="btn btn-secondary btn-rounded float-end" id="button-send-message"><i class="fas fa-paper-plane"></i> <span>Send</span></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-5 col-xl-3 mb-4 mb-md-0">
                                <div class="row justify-content-center mb-3 mt-sm-3 mt-md-0">
                                    <div class="col-md-12 col-sm-6">

                                        <div class="card mask-custom custom-2 mb-md-3">
                                            <div class="card-body d-flex align-items-center justify-content-center">
                                                <div class="col-12 text-center">
                                                    <h5 class="mb-3">Lucy</h5>
                                                    <div class="d-flex justify-content-center mb-4">
                                                        <img src="/img/Lucy.png" class="rounded-circle shadow-1-strong" width="175" height="175" alt="" aria-controls="#picker-editor">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 col-sm-6">
                                        <div class="card mask-custom custom-3 mb-md-3">
                                            <div class="card-body d-flex align-items-center justify-content-center">
                                                <div class="col-12 text-center">
                                                    <h5 class="mb-3">Mustafa</h5>

                                                    <div class="d-flex justify-content-center mb-4">
                                                        <svg class="svg-visualizer" width="175" height="175"></svg>
                                                    </div>
                                                    <button type="button" class="btn btn-info btn-floating" id="mute">
                                                        <i class="fas fa-microphone-alt-slash"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-floating" data-mdb-toggle="modal" data-mdb-target="#modal-log-out">
                                                        <i class="fas fa-sign-out-alt"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
    <!-- Modal Upload File-->
    <div class="modal fade" id="modal-upload-file" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Please select file to upload</h5>
                    <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="customFile">PDF file:</label>
                    <input type="file" class="form-control" id="customFile" />
                    <div class="progress mt-3">
                        <div class="progress-bar" 
                             id="progress-pdf-parser"
                             role="progressbar"
                             style="width: 0%;"
                             aria-valuenow="0"
                             aria-valuemin="0"
                             aria-valuemax="100">
                         </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-mdb-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal Logout-->
    <div class="modal fade" id="modal-log-out" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Logout confirmation</h5>
                    <button type="button" class="btn-close" data-mdb-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="form-label" for="customFile">Are you sure you eant to logout?</p>
                </div>
                <div class="modal-footer">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-sm btn-primary" id="button-log-out">confirm</button>
                        <button type="button" class="btn btn-sm btn-danger" data-mdb-dismiss="modal">Close</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</section>

@section scripts{
    <script src="~/js/app_open_ai.js" asp-append-version="true"></script>
    <script>

        $(() => {

            var app = new app_open_ai();

        });

    </script>
}
