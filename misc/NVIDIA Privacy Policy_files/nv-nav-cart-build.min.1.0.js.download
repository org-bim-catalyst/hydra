    nvcartTemplate = nvcartTemplate + '</g>';
    nvcartTemplate = nvcartTemplate + '</symbol>';
    nvcartTemplate = nvcartTemplate + '<symbol id="n32-caret-right" viewBox="0 0 32 32">';
    nvcartTemplate = nvcartTemplate + '<title>Caret right icon</title>';
    nvcartTemplate = nvcartTemplate + '<desc>Click to expand menu.</desc>';
    nvcartTemplate = nvcartTemplate + '<g id="n32-icon-caret-right-bg" fill="none" stroke="#666" stroke-width="2" opacity="0">';
    nvcartTemplate = nvcartTemplate + '<rect width="32" height="32" stroke="none"></rect>';
    nvcartTemplate = nvcartTemplate + '<rect x="1" y="1" width="30" height="30" fill="none"></rect>';
    nvcartTemplate = nvcartTemplate + '</g>';
    nvcartTemplate = nvcartTemplate + '<path id="n32-icon-caret-right-line-1" d="M1,0,8,7,1,14" transform="translate(11.5 9)" fill="none" stroke="#666" stroke-width="2"></path>';
    nvcartTemplate = nvcartTemplate + '</symbol>';
    nvcartTemplate = nvcartTemplate + '<symbol id="n24-caret-left-small" viewBox="0 0 24 24">';
    nvcartTemplate = nvcartTemplate + '<title>Caret left icon</title>';
    nvcartTemplate = nvcartTemplate + '<desc>Click to collapse menu.</desc>';
    nvcartTemplate = nvcartTemplate + '<defs>';
    nvcartTemplate = nvcartTemplate + '<style>'
