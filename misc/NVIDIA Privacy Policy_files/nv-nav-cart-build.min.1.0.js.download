    nvcartTemplate = nvcartTemplate + '</g>';
    nvcartTemplate = nvcartTemplate + '</symbol>';
    nvcartTemplate = nvcartTemplate + '<symbol id="n24-caret-right" viewBox="0 0 24 24">';
