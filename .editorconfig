root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

# Nullable/analyzer severities apply repo-wide via the IDE; the new src/AskLucy.* and
# tests/AskLucy.*.Tests projects additionally enable analyzers at the project-group
# level via src/Directory.Build.props and tests/Directory.Build.props so the legacy
# "Ask Lucy" project's build behavior is left untouched during the migration.

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
