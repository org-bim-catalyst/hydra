@model ConfirmEmailModel

@if (!String.IsNullOrEmpty(Model.StatusMessage))
{
    var statusMessageClass = Model.StatusMessage.StartsWith("Error");

    if (statusMessageClass)
    {
        <p>
            Error confirming your email.<br />
            It seems like either you use expired or invalid link.<br />
            Please generate new one from <a href='@Url.Page("./ResendEmailConfirmation", new {Email=Model.UserEmail })' target="_self" role="link">here</a>.
        </p>
    }
    else
    {
            @Model.StatusMessage
    }

}
